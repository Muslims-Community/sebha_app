<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/widget_background">

    <!-- Header with Dhikr Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/dhikr_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="سبحان الله"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:fontFamily="serif"
            android:gravity="start" />

        <TextView
            android:id="@+id/target_reached"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ مكتمل"
            android:textSize="14sp"
            android:textColor="#4CAF50"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Count Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/current_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="48sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" / "
            android:textSize="20sp"
            android:textColor="#CCFFFFFF"
            android:layout_marginHorizontal="8dp" />

        <TextView
            android:id="@+id/target_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="33"
            android:textSize="20sp"
            android:textColor="#CCFFFFFF" />

    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginBottom="16dp"
        android:progress="0"
        android:max="100"
        android:progressTint="#FFFFFF"
        android:progressBackgroundTint="#33FFFFFF" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/reset_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="إعادة تعيين"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_button_background"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/increment_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:text="تسبيح +1"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_button_background"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>